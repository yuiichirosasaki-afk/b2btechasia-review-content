{
  "jobs": [
    {
      "functionLocation": "/reviewImport.js",
      "functionName": "importReviewFeed",
      "description": "Import B2B Tech Asia Review articles from the GitHub feed",
      "executionConfig": {
        "cronExpression": "5 * * * *"
      }
    },
    {
      "functionLocation": "/reviewImport.js",
      "functionName": "importVritimes",
      "description": "Import VRITIMES press releases into Siaran Pers",
      "executionConfig": {
        "cronExpression": "35 * * * *"
      }
    },
    {
      "functionLocation": "/exhibitionsImport.js",
      "functionName": "importExhibitions",
      "description": "Import the Indonesian exhibition database (exhibitions.json) into ReviewExhibitions",
      "executionConfig": {
        "cronExpression": "50 * * * *"
      }
    }
  ]
}
